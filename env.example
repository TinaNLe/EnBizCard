# Base URL path for deploying EnBizCard under a subpath.
# Use / for root deployment (e.g. https://example.com/)
# Use /bizcard for subpath deployment (e.g. https://example.com/bizcard)
# This value must be set at BUILD time (it is baked into the static bundle).
NUXT_APP_BASE_URL=

# Port exposed by the Docker production container.
# Map this to any host port you need.
ENBIZCARD_PORT=8000
