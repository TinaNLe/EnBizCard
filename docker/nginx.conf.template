server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;

    # Serve pre-compressed assets if available
    gzip_static on;

    # SPA fallback: any path that doesn't match a real file serves index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets aggressively (Nuxt content-hashes filenames)
    location /_nuxt/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
