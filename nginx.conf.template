server {
    listen 80;
    server_name _;

    # Bind-mounted files (config.json, images) can serve stale with sendfile in Docker.
    sendfile off;
    # Emit relative redirects so the app works behind a reverse proxy.
    absolute_redirect off;

    root /usr/share/nginx/html;

    # `location = / { return 301 ${BASE}/; }` for subpath deploys, empty for root.
    # Generated in the Dockerfile because envsubst cannot branch.
    include /etc/nginx/root-redirect.conf;

    location / {
        try_files $uri $uri/ ${BASE}/index.html;
    }
}
